# PostgreSQL local, descartável e exclusivo para a POC RLS.
# Nunca copie valores de DB_* do Supabase para este arquivo.
RLS_POSTGRES_DATABASE=cosphere_rls_poc
RLS_POSTGRES_ADMIN_USERNAME=cosphere_rls_admin
RLS_POSTGRES_ADMIN_PASSWORD=cosphere_rls_local_only

# Conexão runtime da POC RLS. A role é criada pela suíte isolada.
RLS_DB_HOST=127.0.0.1
RLS_DB_PORT=55432
RLS_DB_DATABASE=cosphere_rls_poc
RLS_DB_USERNAME=cosphere_app_test
RLS_DB_PASSWORD=cosphere_rls_app_local_only
RLS_DB_SCHEMA=public
RLS_DB_SSLMODE=disable
