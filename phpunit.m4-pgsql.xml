<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Integration/Postgres/m4-bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="Module4Postgres">
            <file>tests/Feature/ServiceProviderManagementTest.php</file>
            <file>tests/Feature/MaintenanceManagementTest.php</file>
            <file>tests/Feature/MaintenanceNotificationTest.php</file>
            <file>tests/Feature/MaintenanceQueryTest.php</file>
            <file>tests/Feature/MaintenanceManagementMigrationTest.php</file>
            <file>tests/Feature/IncidentFlowTest.php</file>
            <file>tests/Feature/IncidentQueryTest.php</file>
            <file>tests/Feature/IncidentNotificationTest.php</file>
            <file>tests/Feature/IncidentDomainTest.php</file>
            <file>tests/Feature/MaintenanceRequestDomainTest.php</file>
            <file>tests/Feature/MaintenanceRequestFactoryTest.php</file>
            <file>tests/Feature/OccurrenceMaintenanceMigrationTest.php</file>
            <file>tests/Feature/IncidentAttachmentTest.php</file>
            <file>tests/Feature/DataOwnershipIntegrityTest.php</file>
            <file>tests/Feature/DatabaseSeederTest.php</file>
        </testsuite>
        <testsuite name="Module4Concurrency">
            <file>tests/Integration/Postgres/OccurrenceMaintenanceConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="55434" force="true"/>
        <env name="DB_DATABASE" value="cosphere_m4_test" force="true"/>
        <env name="DB_USERNAME" value="cosphere_m4_test" force="true"/>
        <env name="DB_PASSWORD" value="" force="true"/>
        <env name="DB_SCHEMA" value="public" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_SSLMODE" value="disable" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
