<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Integration/Postgres/m5-bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="Module5PollsPostgres">
            <file>tests/Feature/ResidentPollTest.php</file>
            <file>tests/Feature/PollDomainTest.php</file>
            <file>tests/Feature/AdminPollTest.php</file>
            <file>tests/Feature/PollSecurityTest.php</file>
        </testsuite>
        <testsuite name="Module5NotificationsIntegration">
            <file>tests/Feature/AnnouncementTest.php</file>
            <file>tests/Feature/ResidentAnnouncementTest.php</file>
            <file>tests/Feature/IntegratedNotificationJourneyTest.php</file>
        </testsuite>
        <testsuite name="Module5PollsConcurrency">
            <file>tests/Integration/Postgres/PollConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="55435" force="true"/>
        <env name="DB_DATABASE" value="cosphere_m5_test" force="true"/>
        <env name="DB_USERNAME" value="cosphere_m5_test" force="true"/>
        <env name="DB_PASSWORD" value="cosphere_m5_test" force="true"/>
        <env name="DB_SCHEMA" value="public" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_SSLMODE" value="disable" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
